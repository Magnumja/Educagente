# HTTPS automático para o domínio de produção (DOMINIO no backend/.env).
{$DOMINIO} {
	encode gzip
	# Uploads da oficina vão até 5 MB; folga para o envelope do formulário.
	request_body {
		max_size 6MB
	}
	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy api:8000
}
