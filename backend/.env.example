# --- Django ---
# 1 = modo local (runserver, erros detalhados). O Docker usa 0.
DJANGO_DEBUG=0
# Obrigatória com DJANGO_DEBUG=0. O ./docker-up.sh gera uma se estiver vazia.
DJANGO_SECRET_KEY=
# Hosts aceitos. O Vite repassa /api com Host localhost, então isto basta no laboratório.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Provedor de chat da Oficina RAG (3 etapas) ---
# "anthropic", "openai" ou "ollama"; sem a chave correspondente, a Oficina roda em modo demonstração.
# No fluxo "Projeto" cada aluno usa a própria chave (tela "Minha IA"), que viaja por requisição
# e nunca é guardada no servidor nem no banco; estas chaves ficam só como fallback da turma.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modelo da Oficina (ex.: claude-haiku-5-5 no anthropic, llama3.2:1b no ollama)
LLM_MODEL=claude-haiku-5-5

# --- Ollama (embeddings sempre; chat quando o provedor é "ollama") ---
# No Docker o docker-compose.yml já troca para http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Quantos trechos buscar por pergunta
TOP_K=4
# Similaridade mínima para usar um trecho (abaixo disso: "nada relevante encontrado")
SIMILARITY_THRESHOLD=0.5
