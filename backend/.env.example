# --- Django ---
# 1 = modo local (runserver, erros detalhados, /api/docs). O Docker usa 0.
DJANGO_DEBUG=0
# Obrigatória com DJANGO_DEBUG=0. O ./docker-up.sh gera uma se estiver vazia.
DJANGO_SECRET_KEY=
# Hosts aceitos. No laboratório, inclua o IP da máquina do facilitador (ex.: 192.168.0.10) ou use *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Facilitador ---
# Senha do painel do facilitador (criar oficinas, ver respostas, exportar CSV).
# Vazia = painel desligado. Mínimo de 12 caracteres; não a projete na tela.
FACILITADOR_SENHA=

# --- Modelo de chat (definido pela equipe; o participante não escolhe) ---
# "ollama" (local, grátis), "anthropic" (precisa da chave abaixo) ou "demo" (sem IA, só para ensaiar).
MODEL_PROVIDER=ollama
# Ex.: llama3.2:3b no ollama, claude-haiku-5-5 no anthropic
LLM_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=

# --- Embeddings (busca nas fontes) ---
# "ollama" usa o bge-m3 (multilíngue). "local" funciona sem nenhum serviço, mas só para demonstração.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# No Docker o docker-compose.yml troca para http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
# Quantos trechos entregar à IA por pergunta
TOP_K=4
# Similaridade mínima para usar um trecho (abaixo disso: "não encontrei nas fontes")
SIMILARITY_THRESHOLD=0.5

# --- Produção na internet (docker-compose.prod.yml) ---
# Domínio que aponta para o servidor; o Caddy tira o certificado HTTPS sozinho.
# Coloque o mesmo domínio em DJANGO_ALLOWED_HOSTS. O compose de produção liga DJANGO_HTTPS=1.
DOMINIO=
